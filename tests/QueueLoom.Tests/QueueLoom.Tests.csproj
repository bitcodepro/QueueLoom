<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The transitive Avalonia target only reports build statistics. -->
    <UsedAvaloniaProducts></UsedAvaloniaProducts>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- Keep VSTest/TRX/coverlet on .NET 10 using xUnit's supported MTP-free package. -->
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../QueueLoom.UpdateFixture/QueueLoom.UpdateFixture.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyUpdateFixture" AfterTargets="Build">
    <ItemGroup>
      <UpdateFixtureFiles Include="../QueueLoom.UpdateFixture/bin/$(Configuration)/net10.0/*" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdateFixtureFiles)" DestinationFolder="$(OutDir)UpdateFixture" />
  </Target>

  <ItemGroup>
    <Using Include="Xunit" />
    <None Update="Fixtures/diagnostics-rename-barrier.c" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\QueueLoom.Core\QueueLoom.Core.csproj" />
    <ProjectReference Include="..\..\src\QueueLoom.Infrastructure\QueueLoom.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\QueueLoom.App\QueueLoom.App.csproj" />
    <ProjectReference Include="..\..\src\QueueLoom.Mcp\QueueLoom.Mcp.csproj" />
  </ItemGroup>

</Project>
