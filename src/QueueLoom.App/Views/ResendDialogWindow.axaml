<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QueueLoom.App.ViewModels"
        x:Class="QueueLoom.App.Views.ResendDialogWindow"
        x:DataType="vm:ResendDialogViewModel"
        Title="{Binding Title}"
        Width="640"
        MaxHeight="900"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="26" Spacing="16">
    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />

    <StackPanel Spacing="7">
      <TextBlock Text="SEND TO" Classes="eyebrow" />
      <ComboBox ItemsSource="{Binding DestinationOptions}" SelectedItem="{Binding Destination}"
                HorizontalAlignment="Stretch" AutomationProperties.Name="Destination">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ResendDestinationOption">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>

    <StackPanel Spacing="7">
      <TextBlock Text="ORIGINALS" Classes="eyebrow" />
      <RadioButton GroupName="resendMode" IsChecked="{Binding Copies}" Content="Keep them: send copies only" />
      <RadioButton GroupName="resendMode" IsChecked="{Binding Moves}" IsEnabled="{Binding CanMove}"
                   Content="Move them: send, then back up and remove the originals from the DLQ" />
      <TextBlock Text="{Binding MoveUnavailableReason}"
                 Classes="muted" FontSize="12" IsVisible="{Binding !CanMove}" />
    </StackPanel>

    <CheckBox IsChecked="{Binding PreserveMessageIds}" Content="Preserve Message IDs (duplicate delivery may be suppressed)" />

    <StackPanel Orientation="Horizontal" Spacing="8">
      <NumericUpDown Value="{Binding MessagesPerSecond}" Minimum="1" Maximum="100" Width="120"
                     AutomationProperties.Name="Messages per second" />
      <TextBlock Text="messages per second" Classes="muted" VerticalAlignment="Center" />
    </StackPanel>

    <StackPanel Spacing="7">
      <TextBlock Text="FIND AND REPLACE" Classes="eyebrow" />
      <Grid ColumnDefinitions="*,10,*">
        <TextBox Text="{Binding FindText}" PlaceholderText="Find" AutomationProperties.Name="Find" />
        <TextBox Grid.Column="2" Text="{Binding ReplaceText}" PlaceholderText="Replace with" AutomationProperties.Name="Replace with" />
      </Grid>
      <WrapPanel ItemSpacing="16">
        <CheckBox IsChecked="{Binding ReplaceInBody}" Content="In the body" />
        <CheckBox IsChecked="{Binding ReplaceInProperties}" Content="In the subject, correlation ID and text properties" />
        <CheckBox IsChecked="{Binding MatchCase}" Content="Match case" />
      </WrapPanel>
      <TextBlock Text="{Binding RewritePreview}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Spacing="7">
      <TextBlock Text="WHEN" Classes="eyebrow" />
      <StackPanel Orientation="Horizontal" Spacing="16">
        <RadioButton GroupName="resendWhen" IsChecked="{Binding SendNow}" Content="Now" />
        <RadioButton GroupName="resendWhen" IsChecked="{Binding SendLater}" Content="Later:" />
        <TextBox Text="{Binding SendAtText}" Width="200" IsEnabled="{Binding SendLater}"
                 PlaceholderText="30m, 2h, 03:00" AutomationProperties.Name="Send at" />
      </StackPanel>
      <TextBlock Text="{Binding SendAtDescription}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                 IsVisible="{Binding SendLater}" />
    </StackPanel>

    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
      <TextBlock Text="{Binding Summary}" Classes="muted" TextWrapping="Wrap" MaxWidth="570" />
    </ScrollViewer>

    <StackPanel Spacing="7" IsVisible="{Binding RequiresTypedConfirmation}">
      <TextBlock Text="{Binding EnvironmentName, StringFormat='TYPE {0} TO CONFIRM'}" Classes="eyebrow" />
      <TextBox Text="{Binding TypedConfirmation}" AutomationProperties.Name="Environment name" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Content="Cancel" Classes="quiet" Click="CancelClick" />
      <Button Content="{Binding ConfirmLabel}" Classes="danger" Click="ConfirmClick" IsEnabled="{Binding CanConfirm}" />
    </StackPanel>
  </StackPanel>
  </ScrollViewer>
</Window>
