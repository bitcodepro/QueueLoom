<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QueueLoom.App.ViewModels"
             xmlns:controls="using:QueueLoom.App.Controls"
             x:Class="QueueLoom.App.Views.Pages.ExplorerPage"
             x:DataType="vm:MainWindowViewModel">
  <Grid Margin="{StaticResource PageMargin}" RowDefinitions="Auto,14,Auto,14,*">
    <StackPanel Spacing="4">
      <TextBlock Text="Explorer" Classes="pageTitle" />
      <TextBlock Text="Queues, topics, subscriptions and live runtime counters. Click a column header to sort." Classes="muted" />
    </StackPanel>

    <Grid Grid.Row="2" ColumnDefinitions="*,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto,8,Auto">
      <TextBox Grid.Column="0" MinWidth="150" Text="{Binding SearchText}" Classes="search"
               PlaceholderText="Filter entities…  (Ctrl+F)" AutomationProperties.Name="Filter entities">
        <TextBox.InnerLeftContent>
          <PathIcon Data="{x:Static controls:Icons.Search}" Width="14" Height="14" Margin="10,0,0,0"
                    Foreground="{DynamicResource TextSecondaryBrush}" />
        </TextBox.InnerLeftContent>
      </TextBox>
      <Button Grid.Column="2" Content="Refresh" Classes="quiet" Command="{Binding RefreshTopologyCommand}"
              ToolTip.Tip="Reload queues, topics, subscriptions, and runtime counters (Ctrl+R)" />
      <Button Grid.Column="4" Content="View active" Classes="quiet" Command="{Binding BrowseSelectedActiveCommand}"
              ToolTip.Tip="Non-destructively view active messages in the selected queue or subscription" />
      <Button Grid.Column="6" Content="View DLQ" Classes="primary" Command="{Binding BrowseSelectedDeadLettersCommand}"
              ToolTip.Tip="Peek 100 messages without locking them; load more in Messages" />
      <Button Grid.Column="8" Content="Transfer DLQ" Classes="quiet" Command="{Binding BrowseSelectedTransferDeadLettersCommand}"
              ToolTip.Tip="View messages in the selected transfer dead-letter queue" />
      <Button Grid.Column="10" Content="Rules…" Classes="quiet" Command="{Binding OpenTopicRoutingCommand}"
              IsVisible="{Binding SupportsRouting}"
              ToolTip.Tip="See which messages each subscription of the selected topic receives, check where a message would go, and change the rules" />
      <DropDownButton Grid.Column="12" Content="Manage" IsVisible="{Binding CanManageQueues}"
                      ToolTip.Tip="{Binding ManageQueuesHint}" AutomationProperties.Name="Manage queues">
        <DropDownButton.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <MenuItem Header="{Binding NewQueueLabel}" Command="{Binding CreateQueueCommand}" />
            <MenuItem Header="{Binding QueueSettingsLabel}" Command="{Binding EditQueueSettingsCommand}" />
            <Separator />
            <MenuItem Header="{Binding DeleteQueueLabel}" Command="{Binding DeleteQueueCommand}" Classes="danger" />
          </MenuFlyout>
        </DropDownButton.Flyout>
      </DropDownButton>
    </Grid>

    <Border Grid.Row="4" Classes="card flush">
      <Grid RowDefinitions="Auto,*,Auto" Grid.IsSharedSizeScope="True">
        <Border Classes="tableHeader">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="112" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" MinWidth="84" SharedSizeGroup="Status" />
              <ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="Active" />
              <ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="Dlq" />
              <ColumnDefinition Width="Auto" MinWidth="86" SharedSizeGroup="Transfer" />
              <ColumnDefinition Width="Auto" MinWidth="96" SharedSizeGroup="Scheduled" />
            </Grid.ColumnDefinitions>
            <Button Content="TYPE" Classes="columnHeader" Classes.sorted="{Binding IsSortedByHierarchy}"
                    Command="{Binding SortEntitiesCommand}" CommandParameter="Hierarchy"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    ToolTip.Tip="Group subscriptions under their topic" />
            <Button Grid.Column="1" Content="ENTITY" Classes="columnHeader" Classes.sorted="{Binding IsSortedByName}"
                    Command="{Binding SortEntitiesCommand}" CommandParameter="Name"
                    HorizontalAlignment="Left" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="STATUS" Classes="columnHeader" Classes.sorted="{Binding IsSortedByStatus}"
                    Command="{Binding SortEntitiesCommand}" CommandParameter="Status"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Grid.Column="3" Content="ACTIVE" Classes="columnHeader" Classes.sorted="{Binding IsSortedByActive}"
                    Command="{Binding SortEntitiesCommand}" CommandParameter="Active"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
            <Button Grid.Column="4" Content="DLQ" Classes="columnHeader" Classes.sorted="{Binding IsSortedByDeadLetters}"
                    Command="{Binding SortEntitiesCommand}" CommandParameter="DeadLetters"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
            <Button Grid.Column="5" Content="TRANSFER" Classes="columnHeader" Classes.sorted="{Binding IsSortedByTransferDeadLetters}"
                    Command="{Binding SortEntitiesCommand}" CommandParameter="TransferDeadLetters"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
            <Button Grid.Column="6" Content="SCHEDULED" Classes="columnHeader" Classes.sorted="{Binding IsSortedByScheduled}"
                    Command="{Binding SortEntitiesCommand}" CommandParameter="Scheduled"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
          </Grid>
        </Border>

        <controls:EmptyState Grid.Row="1" IsVisible="{Binding !HasEntities}"
                             Icon="{x:Static controls:Icons.Explorer}"
                             Title="No entities to show"
                             Description="Connect and refresh the namespace, or clear the entity filter.">
          <Button Content="Refresh topology" Classes="quiet" Command="{Binding RefreshTopologyCommand}" />
        </controls:EmptyState>

        <ListBox Grid.Row="1" ItemsSource="{Binding Entities}" SelectedItem="{Binding SelectedEntity}" Margin="6"
                 Classes="tableRows"
                 IsEnabled="{Binding !IsBusy}" IsVisible="{Binding HasEntities}"
                 AutomationProperties.Name="Queues, topics and subscriptions">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:EntityItemViewModel">
              <Grid MinHeight="43">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="112" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" MinWidth="84" SharedSizeGroup="Status" />
                  <ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="Active" />
                  <ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="Dlq" />
                  <ColumnDefinition Width="Auto" MinWidth="86" SharedSizeGroup="Transfer" />
                  <ColumnDefinition Width="Auto" MinWidth="96" SharedSizeGroup="Scheduled" />
                </Grid.ColumnDefinitions>
                <Grid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{Binding KindName, StringFormat='Copy {0} name'}"
                              Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).CopyTextCommand}"
                              CommandParameter="{Binding Name}" />
                    <MenuItem Header="Copy parent topic name" IsVisible="{Binding IsSubscription}"
                              Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).CopyTextCommand}"
                              CommandParameter="{Binding ParentPath}" />
                  </ContextMenu>
                </Grid.ContextMenu>
                <TextBlock Text="{Binding KindLabel}" Classes="eyebrow" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Margin="{Binding IndentMargin}">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" Cursor="Hand"
                             DoubleTapped="OnEntityNameDoubleTapped"
                             ToolTip.Tip="{Binding Name}"
                             AutomationProperties.Name="{Binding Name}"
                             AutomationProperties.HelpText="Double-click or right-click to copy the entity name" />
                  <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11"
                             IsVisible="{Binding HasDetail}"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
                  <TextBlock Text="{Binding ConsumersDisplay}" FontSize="11" IsVisible="{Binding HasConsumers}"
                             Classes.muted="{Binding !HasConsumerLag}" Classes.warning="{Binding HasConsumerLag}"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ConsumersTip}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" Classes="muted" Margin="0,0,12,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding StatusLabel}" />
                <TextBlock Grid.Column="3" Text="{Binding ActiveDisplay}" Classes="numeric" Margin="12,0,0,0"
                           Classes.muted="{Binding !HasActiveMessages}" />
                <TextBlock Grid.Column="4" Text="{Binding DeadLettersDisplay}" Classes="numeric" Margin="12,0,0,0"
                           Classes.danger="{Binding HasDeadLetters}" Classes.muted="{Binding !HasDeadLetters}" />
                <TextBlock Grid.Column="5" Text="{Binding TransferDeadLettersDisplay}" Classes="numeric" Margin="12,0,0,0"
                           Classes.warning="{Binding HasTransferDeadLetters}" Classes.muted="{Binding !HasTransferDeadLetters}" />
                <TextBlock Grid.Column="6" Text="{Binding ScheduledDisplay}" Classes="numeric" Margin="12,0,0,0"
                           Classes.muted="{Binding !HasScheduledMessages}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2" Classes="tableFooter">
          <TextBlock Text="{Binding EntitySortDescription}" Classes="muted" FontSize="11" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
