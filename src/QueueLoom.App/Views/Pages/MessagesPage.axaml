<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QueueLoom.App.ViewModels"
             xmlns:settings="using:QueueLoom.Core.Settings"
             xmlns:views="using:QueueLoom.App.Views"
             xmlns:controls="using:QueueLoom.App.Controls"
             x:Class="QueueLoom.App.Views.Pages.MessagesPage"
             x:DataType="vm:MainWindowViewModel">
  <Grid Margin="{StaticResource PageMargin}" RowDefinitions="Auto,12,Auto,14,*">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="Messages / DLQ" Classes="pageTitle" />
        <TextBlock Text="{Binding MessageListTitle}" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" Content="Scan current environment" Classes="quiet" VerticalAlignment="Bottom"
              Command="{Binding ScanCurrentEnvironmentCommand}"
              ToolTip.Tip="Count dead letters in every queue and subscription; messages are not settled" />
    </Grid>

    <Border Grid.Row="2" Classes="card" Padding="12,10">
      <Grid ColumnDefinitions="*,8,150,8,Auto,8,Auto,8,Auto,8,Auto">
        <TextBox Grid.Column="0" Classes="search"
                 Text="{Binding DeadLetterSearchQuery}"
                 PlaceholderText="Correlation ID, Message ID, subject, body, or application property  (Ctrl+F)"
                 MaxLength="1024"
                 IsEnabled="{Binding !IsBusy}"
                 AutomationProperties.Name="Dead-letter message search">
          <TextBox.InnerLeftContent>
            <PathIcon Data="{x:Static controls:Icons.Search}" Width="14" Height="14" Margin="10,0,0,0"
                      Foreground="{DynamicResource TextSecondaryBrush}" />
          </TextBox.InnerLeftContent>
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SearchDeadLettersCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <ComboBox Grid.Column="2" ItemsSource="{Binding SearchWindowOptions}" SelectedItem="{Binding SearchWindow}"
                  HorizontalAlignment="Stretch" IsEnabled="{Binding !IsBusy}"
                  ToolTip.Tip="Only show messages enqueued within this time" AutomationProperties.Name="Enqueued within">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SearchWindowOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="4" Content="Search DLQ" Classes="primary"
                Command="{Binding SearchDeadLettersCommand}" ToolTip.Tip="Search dead letters (Enter)" />
        <Button Grid.Column="6" Content="Save search" Classes="quiet"
                Command="{Binding SaveSearchCommand}"
                ToolTip.Tip="Keep this text, environment and time window to run again later" />
        <ComboBox Grid.Column="8" Width="190" ItemsSource="{Binding SavedSearches}" SelectedItem="{Binding SelectedSavedSearch}"
                  PlaceholderText="Saved searches" IsEnabled="{Binding HasSavedSearches}"
                  AutomationProperties.Name="Saved searches">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="settings:SavedSearch">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel Grid.Column="10" Orientation="Horizontal" Spacing="6">
          <Button Content="Forget" Classes="quiet" Command="{Binding DeleteSavedSearchCommand}"
                  ToolTip.Tip="Remove the chosen saved search" IsVisible="{Binding HasSavedSearches}" />
          <Button Content="Clear results" Classes="quiet"
                  Command="{Binding ClearDeadLetterSearchCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="4" ColumnDefinitions="310,8,*">
      <!-- Sources -->
      <Border Grid.Column="0" Classes="card" Padding="10" MinWidth="240">
        <Grid RowDefinitions="Auto,8,Auto,8,*,Auto">
          <Grid ColumnDefinitions="*,Auto" Margin="6,4">
            <TextBlock Text="Sources" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding VisibleDlqSourceRowCount}" Classes="warning" FontWeight="SemiBold" />
          </Grid>
          <ComboBox Grid.Row="2" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding DeadLetterEnvironmentFilters}"
                    SelectedItem="{Binding SelectedDeadLetterEnvironmentFilter}"
                    IsEnabled="{Binding !IsBusy}"
                    AutomationProperties.Name="Filter dead-letter sources by environment">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DeadLetterEnvironmentFilterItemViewModel">
                <Grid ColumnDefinitions="Auto,8,*,Auto" MinHeight="24">
                  <Border Classes="envDot" controls:ToneAssist.Background="{Binding EnvironmentTone}" />
                  <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                             ToolTip.Tip="{Binding Name}" />
                  <TextBlock Grid.Column="3" Text="{Binding EnvironmentLabel}" Classes="eyebrow"
                             Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <controls:EmptyState Grid.Row="4" Margin="8,16"
                               IsVisible="{Binding !HasVisibleDlqSources}"
                               Icon="{x:Static controls:Icons.Messages}"
                               Title="No scanned sources"
                               Description="Scan the environment to list queues and subscriptions with dead letters.">
            <Button Content="Scan now" Classes="quiet" Command="{Binding ScanCurrentEnvironmentCommand}" />
          </controls:EmptyState>

          <ListBox Grid.Row="4" MinHeight="80" ItemsSource="{Binding FilteredDeadLetterSources}"
                   SelectedItem="{Binding SelectedDlqSource}" IsEnabled="{Binding !IsBusy}"
                   IsVisible="{Binding HasVisibleDlqSources}"
                   AutomationProperties.Name="Dead-letter sources">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DlqSourceItemViewModel">
                <Grid ColumnDefinitions="Auto,10,*,12,Auto" MinHeight="72">
                  <Grid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{Binding EntityKind, StringFormat='Copy {0} name'}"
                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).CopyTextCommand}"
                                CommandParameter="{Binding EntityName}" />
                      <MenuItem Header="Copy topic name" IsVisible="{Binding IsSubscription}"
                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).CopyTextCommand}"
                                CommandParameter="{Binding ParentTopicName}" />
                    </ContextMenu>
                  </Grid.ContextMenu>
                  <Border Classes="envDot" controls:ToneAssist.Background="{Binding EnvironmentTone}" />
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4" ToolTip.Tip="{Binding EntityPath}">
                    <Grid ColumnDefinitions="Auto,8,*" IsVisible="{Binding IsQueue}">
                      <TextBlock Text="{Binding QueueKindLabel}" Classes="eyebrow accent" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding EntityName}" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Spacing="3" IsVisible="{Binding IsSubscription}">
                      <Grid ColumnDefinitions="Auto,7,*">
                        <TextBlock Text="TOPIC" Classes="eyebrow accent" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding ParentTopicName}" Classes="muted" FontSize="11"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </Grid>
                      <Border Margin="10,0,0,0" Padding="9,2,0,2"
                              BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2,0,0,0">
                        <StackPanel Spacing="1">
                          <TextBlock Text="SUBSCRIPTION" Classes="eyebrow" />
                          <TextBlock Text="{Binding EntityName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock Text="{Binding EnvironmentLabel}" Classes="eyebrow" />
                      <TextBlock Text="{Binding SubQueueLabel}" Classes="eyebrow danger" />
                    </StackPanel>
                    <TextBlock Text="{Binding Error}" Classes="danger" FontSize="11"
                               TextTrimming="CharacterEllipsis" IsVisible="{Binding HasError}"
                               ToolTip.Tip="{Binding Error}" />
                  </StackPanel>
                  <Border Grid.Column="3" Width="1" Background="{DynamicResource HairlineBrush}"
                          Margin="5,7" HorizontalAlignment="Center" />
                  <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="44"
                              IsVisible="{Binding !HasError}">
                    <TextBlock Text="{Binding Count, StringFormat={}{0:N0}}" FontSize="20" FontWeight="SemiBold"
                               Classes="warning" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding Delta}" Classes="muted" FontSize="11" HorizontalAlignment="Right" />
                  </StackPanel>
                  <TextBlock Grid.Column="4" Text="ERROR" Classes="eyebrow danger"
                             IsVisible="{Binding HasError}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Grid.Row="5" Margin="4,8,4,4" Spacing="8">
            <Button Content="Peek selected source" Classes="quiet" HorizontalAlignment="Stretch"
                    Command="{Binding BrowseDlqSourceCommand}" />
            <Expander Header="Backup and purge…" HorizontalAlignment="Stretch"
                      Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HairlineBrush}">
              <StackPanel Spacing="10" Margin="0,4,0,0">
                <TextBlock Text="Message limit per source" FontSize="13" FontWeight="SemiBold" />
                <NumericUpDown Value="{Binding PurgeLimitPerSource}" Minimum="1" Maximum="10000" Increment="100"
                               FormatString="0" MinHeight="40" HorizontalAlignment="Stretch"
                               Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                               BorderBrush="{DynamicResource HairlineBrush}" CornerRadius="8"
                               IsEnabled="{Binding !IsBusy}" AutomationProperties.Name="Purge limit per source" />
                <TextBlock Text="{Binding PurgeLimitHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                <StackPanel Spacing="6" IsEnabled="{Binding HasValidPurgeLimit}">
                  <Button Content="Review source purge…" Classes="danger" HorizontalAlignment="Stretch"
                          Command="{Binding PurgeSelectedDeadLettersCommand}"
                          ToolTip.Tip="Back up and delete the non-empty DLQ entries shown by the latest scan for the selected queue or subscription" />
                  <Button Content="Review topic purge…" Classes="danger" HorizontalAlignment="Stretch"
                          Command="{Binding PurgeTopicDeadLettersCommand}"
                          ToolTip.Tip="Back up and delete the non-empty DLQ entries shown by the latest scan for subscriptions under the selected topic" />
                  <Button Content="Review environment purge…" Classes="danger" HorizontalAlignment="Stretch"
                          Command="{Binding PurgeEnvironmentDeadLettersCommand}"
                          ToolTip.Tip="Back up and delete all non-empty DLQ entries shown by the latest scan for this environment" />
                </StackPanel>
              </StackPanel>
            </Expander>
          </StackPanel>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" />

      <!-- Messages and inspector -->
      <Grid Grid.Column="2" MinWidth="320">
        <Grid.RowDefinitions>
          <RowDefinition Height="0.45*" MinHeight="150" />
          <RowDefinition Height="8" />
          <RowDefinition Height="0.55*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Classes="card flush" MinHeight="150">
          <Grid RowDefinitions="Auto,Auto,*,Auto">
            <Border Classes="tableHeader" Padding="14,0">
              <Grid ColumnDefinitions="32,64,56,1.1*,1.6*,0.9*,146">
                <CheckBox IsChecked="{Binding AreAllMessagesMarked}" IsVisible="{Binding HasDeletableMessages}"
                          MinWidth="0" Padding="0" VerticalAlignment="Center"
                          ToolTip.Tip="Select all dead-lettered messages in the list"
                          AutomationProperties.Name="Select all messages" />
                <TextBlock Grid.Column="1" Text="SEQ" Classes="eyebrow" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="ENV" Classes="eyebrow" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="SOURCE" Classes="eyebrow" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="MESSAGE" Classes="eyebrow" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="REASON" Classes="eyebrow" VerticalAlignment="Center" />
                <TextBlock Grid.Column="6" Text="ENQUEUED" Classes="eyebrow" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <StackPanel Grid.Row="1">
            <!-- Kafka keeps its messages: choose where reading starts -->
            <Border Padding="12,8" IsVisible="{Binding ShowLogReadBar}"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="Auto,10,170,8,*,8,Auto">
                <TextBlock Text="READ" Classes="eyebrow" VerticalAlignment="Center" />
                <ComboBox Grid.Column="2" ItemsSource="{x:Static vm:MainWindowViewModel.LogReadModes}"
                          SelectedItem="{Binding SelectedLogReadMode}" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Where reading starts" />
                <TextBox Grid.Column="4" Text="{Binding LogReadValue}" PlaceholderText="{Binding LogReadPlaceholder}"
                         IsVisible="{Binding HasLogReadValue}" AutomationProperties.Name="Time or offset" />
                <Button Grid.Column="6" Content="Read" Classes="quiet" Command="{Binding ReadLogCommand}"
                        ToolTip.Tip="Read the topic again from the chosen place; Load next 100 then continues from there" />
              </Grid>
            </Border>
            <!-- Why these messages were dead-lettered (or that they are scheduled or deferred); a click ticks all of them -->
            <Border Padding="12,8" IsVisible="{Binding HasDeadLetterReasons}"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="Auto,10,*">
                <StackPanel VerticalAlignment="Center" Spacing="1">
                  <TextBlock Text="{Binding DeadLetterReasonsTitle}" Classes="eyebrow" />
                  <TextBlock Text="{Binding DeadLetterReasonsSummary}" Classes="muted" FontSize="11" />
                </StackPanel>
                <ItemsControl Grid.Column="2" ItemsSource="{Binding DeadLetterReasons}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel ItemSpacing="6" LineSpacing="6" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DeadLetterReasonItemViewModel">
                      <Button Classes="reasonChip" Classes.selected="{Binding IsSelected}"
                              Command="{Binding Select}" CommandParameter="{Binding}" ToolTip.Tip="{Binding ToolTip}"
                              AutomationProperties.Name="{Binding Label}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding Reason}" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                          <Border Classes="chipCount">
                            <TextBlock Text="{Binding Count, StringFormat={}{0:N0}}" FontSize="11" FontWeight="SemiBold" />
                          </Border>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>
            </StackPanel>
            <controls:EmptyState Grid.Row="2" IsVisible="{Binding !HasMessages}"
                                 Icon="{x:Static controls:Icons.Messages}"
                                 Title="No messages loaded"
                                 Description="{Binding EmptyMessagesText}" />
            <ListBox Grid.Row="2" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}" Margin="6"
                     Classes="messageRows" IsEnabled="{Binding !IsBusy}" IsVisible="{Binding HasMessages}"
                     AutomationProperties.Name="Messages">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MessageItemViewModel">
                  <Grid ColumnDefinitions="32,64,56,1.1*,1.6*,0.9*,146" MinHeight="38">
                    <Grid.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Copy Message ID"
                                  Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).CopyTextCommand}"
                                  CommandParameter="{Binding MessageId}" />
                        <MenuItem Header="Copy Correlation ID"
                                  Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).CopyTextCommand}"
                                  CommandParameter="{Binding CorrelationId}" />
                      </ContextMenu>
                    </Grid.ContextMenu>
                    <CheckBox IsChecked="{Binding IsMarked}" IsVisible="{Binding CanDelete}"
                              MinWidth="0" Padding="0" VerticalAlignment="Center"
                              AutomationProperties.Name="{Binding MessageId, StringFormat='Select message {0}'}" />
                    <TextBlock Grid.Column="1" Text="{Binding SequenceDisplay}" Classes="muted" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                      <Border Classes="envDot" HorizontalAlignment="Left"
                              controls:ToneAssist.Background="{Binding EnvironmentTone}" />
                      <TextBlock Text="{Binding EnvironmentLabel}" Classes="eyebrow" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2" Margin="0,0,8,0">
                      <TextBlock Text="{Binding SourceDisplay}" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourceDisplay}" />
                      <TextBlock Text="{Binding SubQueueLabel}" Classes="eyebrow"
                                 Classes.danger="{Binding IsDeadLetter}" Classes.warning="{Binding IsPending}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="2" Margin="0,0,8,0">
                      <TextBlock Text="{Binding MessageId}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding MessageId}" />
                      <TextBlock Text="{Binding BodyPreview}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding BodyPreview}" />
                    </StackPanel>
                    <TextBlock Grid.Column="5" Text="{Binding StatusDetail}" Margin="0,0,8,0"
                               Classes.danger="{Binding IsDeadLetter}" Classes.warning="{Binding IsPending}"
                               Classes.muted="{Binding !CanDelete}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding StatusDetail}" />
                    <TextBlock Grid.Column="6" Text="{Binding EnqueuedAt}" Classes="muted" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding EnqueuedAt}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Row="3" Classes="tableFooter">
              <Grid ColumnDefinitions="*,Auto,8,Auto,8,Auto,8,Auto">
                <TextBlock Text="{Binding BrowsePageStatus}" Classes="muted" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Load next 100" Command="{Binding LoadMoreMessagesCommand}" Classes="quiet copyAction" />
                <Button Grid.Column="3" Content="{Binding ExportMessagesLabel}" Classes="quiet copyAction"
                        Command="{Binding ExportMessagesCommand}"
                        ToolTip.Tip="Save the ticked messages, or all listed ones, to a JSON or CSV file" />
                <Button Grid.Column="5" Content="{Binding ResendMarkedMessagesLabel}" Classes="quiet copyAction"
                        Command="{Binding ResendMarkedMessagesCommand}" IsVisible="{Binding HasDeadLetterMessages}"
                        ToolTip.Tip="Send the ticked messages again, as copies or moving them out of the DLQ. Requires write access." />
                <Button Grid.Column="7" Content="{Binding DeleteMarkedMessagesLabel}" Classes="danger copyAction"
                        Command="{Binding DeleteMarkedMessagesCommand}" IsVisible="{Binding ShowDeleteMarkedMessages}"
                        ToolTip.Tip="{Binding DeleteMarkedMessagesTip}" />
              </Grid>
            </Border>
          </Grid>
        </Border>

        <GridSplitter Grid.Row="1" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent" />

        <Border Grid.Row="2" Classes="card" MinHeight="100">
          <Grid>
            <controls:EmptyState IsVisible="{Binding !HasSelectedMessage}"
                                 Icon="{x:Static controls:Icons.Search}"
                                 Title="Select a message"
                                 Description="Its body, broker properties and dead-letter reason appear here." />
            <Grid RowDefinitions="Auto,10,*" IsVisible="{Binding HasSelectedMessage}">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                  <TextBlock Text="Message inspector" Classes="sectionTitle" />
                  <TextBlock Text="{Binding SelectedMessage?.CorrelationId, StringFormat='Correlation ID: {0}'}"
                             Classes="muted" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding SelectedMessage?.EditLimitText}" Classes="warning"
                             FontSize="11" IsVisible="{Binding !SelectedMessage?.CanOpenAsDraft}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                  <Button Content="Copy body" Classes="quiet copyAction"
                          Command="{Binding CopyTextCommand}" CommandParameter="{Binding SelectedMessage?.BodyText}" />
                  <Button Content="Copy properties" Classes="quiet copyAction"
                          Command="{Binding CopyTextCommand}" CommandParameter="{Binding SelectedMessage?.PropertiesJson}" />
                  <Button Content="Open as draft" Classes="primary copyAction" Command="{Binding OpenMessageAsDraftCommand}"
                          ToolTip.Tip="Copy this message into the composer; the original message is unchanged" />
                </StackPanel>
              </Grid>
              <views:MessageDetailsView Grid.Row="2" DataContext="{Binding SelectedMessage}" />
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
