<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QueueLoom.App.ViewModels"
             xmlns:views="using:QueueLoom.App.Views"
             xmlns:controls="using:QueueLoom.App.Controls"
             x:Class="QueueLoom.App.Views.Pages.BackupsPage"
             x:DataType="vm:MainWindowViewModel">
  <Grid Margin="{StaticResource PageMargin}" RowDefinitions="Auto,14,Auto,Auto,*">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="Backups" Classes="pageTitle" />
        <TextBlock Text="Inspect local backups or replay copies after reviewing the destination."
                   Classes="muted" TextWrapping="Wrap" />
        <TextBlock Text="{Binding BackupRootDirectory}" Classes="muted" FontSize="11"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding BackupRootDirectory}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9" VerticalAlignment="Bottom">
        <Button Content="Open folder" Classes="quiet" Command="{Binding OpenBackupsFolderCommand}"
                ToolTip.Tip="Show the backup folder in the file manager" />
        <Button Content="Refresh" Classes="primary" Command="{Binding RefreshBackupsCommand}" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="2" Classes="card" Padding="12">
      <Grid ColumnDefinitions="*,12,Auto,12,Auto" VerticalAlignment="Center">
        <TextBox Classes="search" Text="{Binding BackupFilterText}"
                 PlaceholderText="Filter by environment, source, Message ID, Correlation ID, or subject…  (Ctrl+F)"
                 AutomationProperties.Name="Filter backups">
          <TextBox.InnerLeftContent>
            <PathIcon Data="{x:Static controls:Icons.Search}" Width="14" Height="14" Margin="10,0,0,0"
                      Foreground="{DynamicResource TextSecondaryBrush}" />
          </TextBox.InnerLeftContent>
        </TextBox>
        <TextBlock Grid.Column="2" Text="{Binding VisibleBackupCount, StringFormat='{}{0:N0} messages'}"
                   Classes="muted" VerticalAlignment="Center" />
        <Button Grid.Column="4" Content="{Binding DeleteVisibleBackupsLabel}" Classes="danger"
                Command="{Binding DeleteVisibleBackupsCommand}"
                ToolTip.Tip="Delete every backup shown: the chosen group on the left, narrowed by the filter" />
      </Grid>
    </Border>

    <Expander Grid.Row="3" Header="Batch restore / replay" Margin="0,10" IsExpanded="False" HorizontalAlignment="Stretch">
      <StackPanel Spacing="10" Margin="6">
        <TextBlock Text="{Binding ReplayStatus}" Classes="muted" TextWrapping="Wrap" />
        <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="8">
          <ComboBox Width="260" ItemsSource="{Binding Destinations}" SelectedItem="{Binding ReplayDestination}"
                    PlaceholderText="Replay destination" IsEnabled="{Binding !IsBusy}" AutomationProperties.Name="Replay destination">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DestinationItemViewModel">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <NumericUpDown Width="120" Value="{Binding ReplayRate}" Minimum="1" Maximum="50"
                           IsEnabled="{Binding !IsBusy}" AutomationProperties.Name="Replay messages per second" />
            <TextBlock Text="per second" Classes="muted" VerticalAlignment="Center" />
          </StackPanel>
          <CheckBox Content="Preserve Message IDs" IsChecked="{Binding PreserveReplayMessageIds}" IsEnabled="{Binding !IsBusy}" />
        </WrapPanel>
        <WrapPanel ItemSpacing="8" LineSpacing="8">
          <Button Content="Restore filtered backups…" Command="{Binding RestoreFilteredBackupsCommand}" Classes="primary" />
          <Button Content="Replay loaded messages…" Command="{Binding ReplayLoadedMessagesCommand}" Classes="quiet" />
          <Button Content="Resume latest batch…" Command="{Binding ResumeReplayCommand}" Classes="quiet" />
        </WrapPanel>
      </StackPanel>
    </Expander>

    <Grid Grid.Row="4" ColumnDefinitions="220,8,1.35*,8,*" MinHeight="320">
      <!-- Groups: all backups, environments, topics with their subscriptions, queues -->
      <Border Grid.Column="0" Classes="card flush">
        <Grid RowDefinitions="Auto,*">
          <Border Classes="tableHeader" Padding="14,0">
            <TextBlock Text="GROUPS" Classes="eyebrow" VerticalAlignment="Center" />
          </Border>
          <ListBox Grid.Row="1" ItemsSource="{Binding BackupGroups}" SelectedItem="{Binding SelectedBackupGroup}"
                   IsEnabled="{Binding !IsBusy}" Margin="6" AutomationProperties.Name="Backup groups">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:BackupGroupItemViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="{Binding IndentMargin}" AutomationProperties.Name="{Binding Title}">
                  <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding KindLabel}" Classes="eyebrow" FontSize="9"
                               controls:ToneAssist.Foreground="{Binding Tone}" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Title}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat='{}{0:N0}'}" Classes="numeric muted"
                             VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" />

      <Border Grid.Column="2" Classes="card flush" MinWidth="320">
        <Grid RowDefinitions="Auto,*,Auto">
          <Border Classes="tableHeader" Padding="14,0">
            <Grid ColumnDefinitions="56,1.2*,1.5*,96,96">
              <TextBlock Text="ENV" Classes="eyebrow" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="SOURCE" Classes="eyebrow" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="MESSAGE" Classes="eyebrow" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" Text="ENQUEUED" Classes="eyebrow" VerticalAlignment="Center" />
              <TextBlock Grid.Column="4" Text="BACKED UP" Classes="eyebrow" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <controls:EmptyState Grid.Row="1" IsVisible="{Binding !HasVisibleBackups}"
                               Icon="{x:Static controls:Icons.Backups}"
                               Title="No backups found"
                               Description="Purges save a backup here first. Adjust the filter or refresh the list." />
          <ListBox Grid.Row="1" ItemsSource="{Binding FilteredBackupMessages}"
                   SelectedItem="{Binding SelectedBackup}"
                   SelectionChanged="OnBackupSelectionChanged"
                   IsEnabled="{Binding !IsBusy}" IsVisible="{Binding HasVisibleBackups}" Margin="6"
                   AutomationProperties.Name="Backed up messages">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:BackupMessageItemViewModel">
                <Grid ColumnDefinitions="56,1.2*,1.5*,96,96" MinHeight="64" ToolTip.Tip="{Binding FilePath}">
                  <StackPanel VerticalAlignment="Center" Spacing="3">
                    <Border Classes="envDot" HorizontalAlignment="Left"
                            controls:ToneAssist.Background="{Binding EnvironmentTone}" />
                    <TextBlock Text="{Binding EnvironmentLabel}" Classes="eyebrow"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ProfileName}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,8,0">
                    <TextBlock Text="{Binding SourceKind}" Classes="eyebrow" />
                    <TextBlock Text="{Binding SourceDisplay}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourceDisplay}" />
                    <TextBlock Text="{Binding SubQueueLabel}" Classes="eyebrow danger" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" Margin="0,0,8,0">
                    <TextBlock Text="{Binding MessageId}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding MessageId}" />
                    <TextBlock Text="{Binding CorrelationId, StringFormat='Correlation: {0}'}" Classes="muted" FontSize="11"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CorrelationId}" />
                    <TextBlock Text="{Binding Error}" Classes="danger" FontSize="11"
                               TextTrimming="CharacterEllipsis" IsVisible="{Binding HasError}" ToolTip.Tip="{Binding Error}" />
                  </StackPanel>
                  <TextBlock Grid.Column="3" Text="{Binding EnqueuedAt}" Classes="muted" FontSize="11"
                             TextWrapping="Wrap" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="{Binding BackedUpAt}" Classes="muted" FontSize="11"
                             TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border Grid.Row="2" Classes="tableFooter">
            <TextBlock Text="{Binding BackupStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          </Border>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" />

      <Border Grid.Column="4" Classes="card" MinWidth="300">
        <Grid>
          <controls:EmptyState IsVisible="{Binding !HasLoadedBackupMessage}"
                               Icon="{x:Static controls:Icons.Backups}"
                               Title="Select a backup message"
                               Description="The body and properties are loaded from its local JSON file." />
          <Grid RowDefinitions="Auto,10,*" IsVisible="{Binding HasLoadedBackupMessage}">
            <StackPanel Spacing="10">
              <StackPanel Spacing="3">
                <TextBlock Text="Saved message" Classes="sectionTitle" />
                <TextBlock Text="{Binding SelectedBackup?.SourceDisplay}" Classes="muted"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedBackup?.SourceDisplay}" />
                <TextBlock Text="{Binding SelectedBackupMessage?.CorrelationId, StringFormat='Correlation ID: {0}'}"
                           Classes="muted" FontSize="11" />
                <TextBlock Text="{Binding BackupDraftHint}" Classes="warning"
                           FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasBackupDraftHint}" />
              </StackPanel>
              <WrapPanel ItemSpacing="8" LineSpacing="8">
                <Button Content="Copy body" Classes="quiet copyAction"
                        Command="{Binding CopyTextCommand}" CommandParameter="{Binding SelectedBackupMessage?.BodyText}" />
                <Button Content="Copy properties" Classes="quiet copyAction"
                        Command="{Binding CopyTextCommand}" CommandParameter="{Binding SelectedBackupMessage?.PropertiesJson}" />
                <Button Content="Open as draft" Classes="primary copyAction" Command="{Binding OpenBackupAsDraftCommand}"
                        ToolTip.Tip="Copy this backup into the composer; the local JSON file is unchanged" />
                <Button Content="Delete backup" Classes="danger copyAction" Command="{Binding DeleteSelectedBackupCommand}" />
              </WrapPanel>
            </StackPanel>
            <views:MessageDetailsView Grid.Row="2" DataContext="{Binding SelectedBackupMessage}" />
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
