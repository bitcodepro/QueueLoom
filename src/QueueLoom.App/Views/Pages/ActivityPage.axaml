<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QueueLoom.App.ViewModels"
             xmlns:controls="using:QueueLoom.App.Controls"
             x:Class="QueueLoom.App.Views.Pages.ActivityPage"
             x:DataType="vm:MainWindowViewModel">
  <Grid Margin="{StaticResource PageMargin}" RowDefinitions="Auto,14,*,14,*">
    <StackPanel Spacing="14">
      <StackPanel Spacing="4">
        <TextBlock Text="Activity" Classes="pageTitle" />
        <TextBlock Text="Local history of connections, scans, sends and purges. Right-click a row to copy." Classes="muted" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Clear Activity view…" Command="{Binding ClearActivityViewCommand}" />
          <Button Content="Restore Activity view" Command="{Binding RestoreActivityViewCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding ActivityViewNotice}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
      </StackPanel>
      <!-- Resends waiting for their time -->
      <Border Classes="card" IsVisible="{Binding HasScheduledResends}">
        <StackPanel Spacing="10">
          <StackPanel Spacing="3">
            <TextBlock Text="Scheduled resends" Classes="sectionTitle" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Each one runs when it is due while QueueLoom is open, connected to its environment with write access on." />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding ScheduledResends}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ScheduledResendItemViewModel">
                <Grid ColumnDefinitions="*,12,Auto,8,Auto" Margin="0,4">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                    <TextBlock Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding When}" />
                      <Run Text=" · " />
                      <Run Text="{Binding Status}" />
                    </TextBlock>
                  </StackPanel>
                  <Button Grid.Column="2" Content="Run now" Classes="quiet" Command="{Binding RunNow}" CommandParameter="{Binding}" />
                  <Button Grid.Column="4" Content="Cancel" Classes="quiet" Command="{Binding Cancel}" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
    <Border Grid.Row="2" Classes="card" Padding="12">
      <Grid RowDefinitions="Auto,Auto,Auto,*">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Refresh operations" Command="{Binding RefreshOperationHistoryCommand}" />
          <TextBlock Text="Operation history" Classes="sectionTitle" />
        </DockPanel>
        <StackPanel Grid.Row="1" Grid.RowSpan="3" Name="OperationHistoryEmptyState" IsVisible="{Binding !HasOperationHistory}"
                    Spacing="6" Margin="0,14" VerticalAlignment="Center" MaxWidth="720">
          <TextBlock Text="No operation history yet" Classes="sectionTitle" />
          <TextBlock Text="Use Resend on selected DLQ messages, Replay loaded messages, or Restore filtered backups to save outcomes here. Scheduled resends appear when they start."
                     Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="Refresh operations to check for saved history from another window." Classes="muted" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
        <ComboBox Grid.Row="1" ItemsSource="{Binding OperationHistory}" SelectedItem="{Binding SelectedOperation, Mode=TwoWay}" Margin="0,8"
                  IsVisible="{Binding HasOperationHistory}"
                  AutomationProperties.Name="Operation history">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:OperationHistoryViewModel"><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel Grid.Row="2" Spacing="4" IsVisible="{Binding HasOperationHistory}">
          <TextBlock Text="Select any row to inspect its outcome. Tick Pending items to continue, or Rejected items to retry proven failures. Unknown and confirmed sends cannot be resent. Move deletion recovery requires manual inspection." TextWrapping="Wrap" Classes="muted" FontSize="12" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Continue unattempted" Command="{Binding ContinueOperationCommand}" />
            <Button Content="Retry proven failures" Command="{Binding RetryRejectedOperationCommand}" />
          </StackPanel>
        </StackPanel>
        <Grid Grid.Row="3" ColumnDefinitions="*,12,*" Margin="0,8,0,0" IsVisible="{Binding HasOperationHistory}">
          <ListBox ItemsSource="{Binding OperationItems}" SelectedItem="{Binding SelectedOperationItem, Mode=TwoWay}"
                   MaxHeight="220" AutomationProperties.Name="Operation item outcomes">
            <ListBox.Styles>
              <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate><DataTemplate x:DataType="vm:OperationItemViewModel">
              <Grid ColumnDefinitions="Auto,*" Margin="0,3">
                <CheckBox IsChecked="{Binding IsMarked, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" Margin="0,0,8,0"
                          AutomationProperties.Name="Mark item for recovery" ToolTip.Tip="Only Pending or Rejected items can be marked for recovery. Select the row to inspect any outcome." />
                <StackPanel Grid.Column="1"><TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Description}" /><TextBlock Text="{Binding Outcome}" Classes="muted" TextTrimming="CharacterEllipsis" FontSize="12" /></StackPanel>
              </Grid>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <TextBox Grid.Column="2" Name="OperationItemDetails" Text="{Binding SelectedOperationItemDetails, Mode=OneWay}"
                   IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="220"
                   PlaceholderText="Select an item to inspect its full outcome." AutomationProperties.Name="Operation item details"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Grid>
      </Grid>
    </Border>
    <Border Grid.Row="4" Classes="card flush">
      <Grid RowDefinitions="Auto,*">
        <Border Classes="tableHeader">
          <Grid ColumnDefinitions="90,100,220,*">
            <TextBlock Text="TIME" Classes="eyebrow" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="LEVEL" Classes="eyebrow" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="ACTION" Classes="eyebrow" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="DETAILS" Classes="eyebrow" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <controls:EmptyState Grid.Row="1" IsVisible="{Binding !HasActivity}"
                             Icon="{x:Static controls:Icons.Activity}"
                             Title="No activity yet"
                             Description="Connections, scans, sends and purges are recorded here and in the local journal." />
        <ListBox Grid.Row="1" ItemsSource="{Binding Activity}" Margin="6" Classes="tableRows" IsVisible="{Binding HasActivity}"
                 AutomationProperties.Name="Activity history">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ActivityItemViewModel">
              <Grid ColumnDefinitions="90,100,220,*" MinHeight="38">
                <Grid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Copy details"
                              Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).CopyTextCommand}"
                              CommandParameter="{Binding Details}" />
                    <MenuItem Header="Copy entity name" IsVisible="{Binding HasSource}"
                              Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).CopyTextCommand}"
                              CommandParameter="{Binding EntityName}" />
                    <MenuItem Header="Copy parent topic name" IsVisible="{Binding IsSubscription}"
                              Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).CopyTextCommand}"
                              CommandParameter="{Binding ParentTopicName}" />
                  </ContextMenu>
                </Grid.ContextMenu>
                <TextBlock Text="{Binding Time}" Classes="muted" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Level}" FontWeight="SemiBold" VerticalAlignment="Center"
                           controls:ToneAssist.Foreground="{Binding LevelTone}" />
                <TextBlock Grid.Column="2" Text="{Binding Action}" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Action}" Margin="0,0,8,0" />
                <TextBlock Grid.Column="3" Text="{Binding Details}" Classes="muted" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Details}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</UserControl>
