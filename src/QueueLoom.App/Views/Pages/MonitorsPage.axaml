<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QueueLoom.App.ViewModels"
             xmlns:controls="using:QueueLoom.App.Controls"
             x:Class="QueueLoom.App.Views.Pages.MonitorsPage"
             x:DataType="vm:MainWindowViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="{StaticResource PageMargin}" Spacing="18">
      <StackPanel Spacing="4">
        <TextBlock Text="Monitors" Classes="pageTitle" />
        <TextBlock Text="Watches dead-letter counts and keeps their history. Services without counters (local emulators) are counted by reading and releasing messages." Classes="muted" />
      </StackPanel>

      <Grid ColumnDefinitions="1.25*,16,*">
        <Border Grid.Column="0" Classes="card">
          <StackPanel Spacing="16">
            <TextBlock Text="Monitor settings" Classes="sectionTitle" />
            <Grid ColumnDefinitions="*,14,180">
              <StackPanel Grid.Column="0" Spacing="7">
                <TextBlock Text="SCOPE" Classes="eyebrow" />
                <ComboBox ItemsSource="{Binding MonitorScopes}" SelectedItem="{Binding MonitorScope}"
                          HorizontalAlignment="Stretch" IsEnabled="{Binding !IsMonitoring}"
                          AutomationProperties.Name="Monitor scope" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="7">
                <TextBlock Text="INTERVAL · SECONDS" Classes="eyebrow" />
                <NumericUpDown Value="{Binding MonitorIntervalSeconds}" Minimum="15" Maximum="86400" Increment="15"
                               FormatString="0" IsEnabled="{Binding !IsMonitoring}"
                               AutomationProperties.Name="Monitor interval in seconds" />
              </StackPanel>
            </Grid>
            <Border Classes="callout" IsVisible="{Binding IsSelectedSourceMonitorScope}">
              <StackPanel Spacing="8">
                <TextBlock Text="SINGLE-SOURCE TARGET" Classes="eyebrow" />
                <ComboBox ItemsSource="{Binding MonitorTargetChoices}" SelectedItem="{Binding MonitorTargetChoice}"
                          HorizontalAlignment="Stretch" IsEnabled="{Binding !IsMonitoring}"
                          AutomationProperties.Name="Monitor target" />
                <TextBlock Text="{Binding MonitorTargetPreview}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <TextBlock Text="Minimum interval is 15 seconds. Single-source mode pins the explicit target shown above. A scan is skipped while another workspace operation is active."
                       Classes="muted" TextWrapping="Wrap" />
            <Button Content="{Binding MonitorButtonLabel}" Classes="primary" Command="{Binding ToggleMonitorCommand}" HorizontalAlignment="Left" />

            <Border Classes="divider" />
            <TextBlock Text="Alerts outside QueueLoom" Classes="sectionTitle" />
            <CheckBox IsChecked="{Binding SystemNotifications}"
                      Content="Show a system notification when new dead letters appear and QueueLoom is in the background" />
            <StackPanel Spacing="7">
              <TextBlock Text="SLACK OR TEAMS WEBHOOK · OPTIONAL" Classes="eyebrow" />
              <TextBox Text="{Binding AlertWebhookUrl}" PlaceholderText="https://hooks.slack.com/services/…"
                       AutomationProperties.Name="Alert webhook address" />
              <TextBlock Text="{Binding AlertWebhookError}" Classes="danger" FontSize="12" TextWrapping="Wrap"
                         IsVisible="{Binding HasAlertWebhookError}" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="Alerts name the environment and the queue or subscription, never message contents." />
            </StackPanel>
            <Button Content="Send test alert" Classes="quiet" Command="{Binding SendTestAlertCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Text="STATUS" Classes="eyebrow" />
            <TextBlock Text="{Binding MonitorStatus}" Classes="sectionTitle" TextWrapping="Wrap" />
            <Border Classes="warningAlert" IsVisible="{Binding HasMonitorAlert}">
              <TextBlock Text="{Binding MonitorAlert}" Classes="warning" TextWrapping="Wrap" />
            </Border>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="NOTIFICATIONS" Classes="eyebrow" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="Clear" Classes="quiet statusAction"
                      Command="{Binding ClearMonitorNotificationsCommand}"
                      IsVisible="{Binding HasMonitorNotifications}" />
            </Grid>
            <controls:EmptyState IsVisible="{Binding !HasMonitorNotifications}" Margin="8"
                                 Icon="{x:Static controls:Icons.Monitors}"
                                 Title="No retained notifications"
                                 Description="New dead letters found by the monitor are listed here until cleared." />
            <ListBox ItemsSource="{Binding MonitorNotifications}" MaxHeight="260"
                     IsVisible="{Binding HasMonitorNotifications}" AutomationProperties.Name="Monitor notifications">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MonitorNotificationItemViewModel">
                  <Grid RowDefinitions="Auto,Auto,Auto" Margin="2,4">
                    <Grid.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Copy entity name"
                                  Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).CopyTextCommand}"
                                  CommandParameter="{Binding EntityName}" />
                        <MenuItem Header="Copy topic name" IsVisible="{Binding IsSubscription}"
                                  Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).CopyTextCommand}"
                                  CommandParameter="{Binding ParentTopicName}" />
                      </ContextMenu>
                    </Grid.ContextMenu>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding SourceName}" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourceName}" />
                      <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat={}{0:N0}}" FontWeight="Bold"
                                 Classes="danger" Margin="10,0,0,0" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding EnvironmentName}" Classes="muted" FontSize="11" />
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding SubQueueLabel}" Classes="eyebrow" />
                      <TextBlock Grid.Column="1" Text="{Binding FirstDetectedText, StringFormat='Found {0}'}"
                                 Classes="muted" FontSize="11" />
                    </Grid>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="The desktop monitor runs while QueueLoom is open. Use Azure Monitor for guaranteed 24/7 alerting."
                       Classes="muted" TextWrapping="Wrap" FontSize="12" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Classes="card" IsVisible="{Binding IsHistoryAvailable}">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto,10,Auto">
            <StackPanel Spacing="3" VerticalAlignment="Center">
              <TextBlock Text="Dead-letter history" Classes="sectionTitle" />
              <TextBlock Text="How many messages sat in the dead-letter queues of an environment over time."
                         Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox Grid.Column="1" Width="290" ItemsSource="{Binding Profiles}" SelectedItem="{Binding HistoryProfile}"
                      PlaceholderText="Choose environment" AutomationProperties.Name="History environment">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ProfileItemViewModel">
                  <Grid ColumnDefinitions="Auto,9,*,Auto">
                    <Border Classes="envDot" controls:ToneAssist.Background="{Binding EnvironmentTone}" />
                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <controls:ProviderBadge Grid.Column="3" Provider="{Binding Provider}" Margin="8,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Grid.Column="3" Width="150" ItemsSource="{Binding HistoryRanges}" SelectedItem="{Binding HistoryRange}"
                      AutomationProperties.Name="History period" />
          </Grid>

          <controls:EmptyState IsVisible="{Binding !HasHistory}" Margin="8,18"
                               Icon="{x:Static controls:Icons.Monitors}"
                               Title="Nothing recorded yet"
                               Description="{Binding HistoryEmptyText}" />

          <Grid ColumnDefinitions="*,24,300" IsVisible="{Binding HasHistory}">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="36">
                <StackPanel Spacing="2">
                  <TextBlock Text="NOW" Classes="eyebrow" />
                  <TextBlock Text="{Binding HistoryNowText}" Classes="statValue" />
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Text="PEAK" Classes="eyebrow" />
                  <TextBlock Text="{Binding HistoryPeakText}" Classes="statValue" />
                  <TextBlock Text="{Binding HistoryPeakTime}" Classes="muted" FontSize="11" />
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Text="CHANGE IN PERIOD" Classes="eyebrow" />
                  <TextBlock Text="{Binding HistoryChangeText}" Classes="statValue"
                             Classes.danger="{Binding IsHistoryRising}" Classes.success="{Binding IsHistoryFalling}" />
                </StackPanel>
              </StackPanel>
              <controls:HistoryChart Height="210" Points="{Binding HistoryPoints}"
                                     From="{Binding HistoryFrom}" To="{Binding HistoryTo}"
                                     LineBrush="{DynamicResource WarningBrush}"
                                     GridBrush="{DynamicResource HairlineBrush}"
                                     LabelBrush="{DynamicResource TextSecondaryBrush}"
                                     TooltipBrush="{DynamicResource SurfaceRaisedBrush}"
                                     AutomationProperties.Name="Dead-letter count over time" />
              <TextBlock Text="{Binding HistoryFootnote}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="10">
              <TextBlock Text="LARGEST DEAD-LETTER QUEUES" Classes="eyebrow" />
              <TextBlock Text="The queues were empty at the last check." Classes="muted"
                         IsVisible="{Binding !HasHistorySources}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding HistorySources}" IsVisible="{Binding HasHistorySources}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DeadLetterTrendItemViewModel">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,5">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding NowText}" FontWeight="SemiBold" Margin="10,0"
                                 VerticalAlignment="Center" />
                      <Border Grid.Column="2" Classes="trend" Classes.rising="{Binding IsRising}"
                              Classes.falling="{Binding IsFalling}" MinWidth="64">
                        <TextBlock Text="{Binding ChangeText}" FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding HasConsumerRows}">
        <StackPanel Spacing="12">
          <StackPanel Spacing="3">
            <TextBlock Text="Consumers" Classes="sectionTitle" />
            <TextBlock Text="{Binding ConsumerRowsCaption}" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding ConsumerRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EntityItemViewModel">
                <Grid ColumnDefinitions="90,*,Auto" Margin="0,5">
                  <TextBlock Text="{Binding KindLabel}" Classes="eyebrow" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" ToolTip.Tip="{Binding Name}" />
                  <TextBlock Grid.Column="2" Text="{Binding ConsumersDisplay}" Margin="12,0,0,0" VerticalAlignment="Center"
                             Classes.muted="{Binding !HasConsumerLag}" Classes.warning="{Binding HasConsumerLag}"
                             ToolTip.Tip="{Binding ConsumersTip}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
