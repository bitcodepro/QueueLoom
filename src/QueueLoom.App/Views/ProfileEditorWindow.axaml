<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QueueLoom.App.ViewModels"
        xmlns:controls="using:QueueLoom.App.Controls"
        x:Class="QueueLoom.App.Views.ProfileEditorWindow"
        x:DataType="vm:ProfileEditorViewModel"
        Title="{Binding DialogTitle}"
        Width="700"
        Height="780"
        MinWidth="600"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}">
    <Border Grid.Row="0" Padding="28,24" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding DialogTitle}" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="{Binding SecretNote}" Classes="muted" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="28,22" Spacing="16">
        <StackPanel Spacing="7">
          <TextBlock Text="SERVICE" Classes="eyebrow" />
          <ListBox x:Name="ProviderPicker" Classes="providerPicker"
                   ItemsSource="{Binding ProviderOptions}"
                   SelectedItem="{Binding SelectedProvider}"
                   IsEnabled="{Binding CanChangeProvider}"
                   AutomationProperties.Name="Messaging service">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="3" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProviderOption">
                <StackPanel Spacing="8" AutomationProperties.Name="{Binding Title}">
                  <controls:ProviderBadge Provider="{Binding Provider}" />
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="The service of a saved environment cannot be changed. Add a new environment instead."
                     Classes="muted" FontSize="12" IsVisible="{Binding !CanChangeProvider}" />
        </StackPanel>

        <StackPanel Spacing="7">
          <TextBlock Text="DISPLAY NAME" Classes="eyebrow" />
          <TextBox Text="{Binding Name}" PlaceholderText="Payments · Dev" />
        </StackPanel>

        <Grid ColumnDefinitions="*,14,*">
          <StackPanel Grid.Column="0" Spacing="7">
            <TextBlock Text="ENVIRONMENT" Classes="eyebrow" />
            <ComboBox ItemsSource="{Binding EnvironmentKinds}" SelectedItem="{Binding Environment}" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="7">
            <TextBlock Text="ACCESS" Classes="eyebrow" />
            <ComboBox ItemsSource="{Binding AccessModes}" SelectedItem="{Binding AccessMode}" IsEnabled="{Binding !IsProduction}"
                      HorizontalAlignment="Stretch" />
          </StackPanel>
        </Grid>

        <StackPanel Spacing="4">
          <CheckBox IsChecked="{Binding AllowQueueManagement}" Content="Allow creating, changing and deleting queues"
                    AutomationProperties.Name="Allow queue management" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="28,0,0,0"
                     Text="Also needs write access. Deleting a queue always asks you to type its name." />
        </StackPanel>

        <StackPanel Spacing="7" IsVisible="{Binding IsCustomEnvironment}">
          <TextBlock Text="CUSTOM ENVIRONMENT LABEL" Classes="eyebrow" />
          <TextBox Text="{Binding CustomEnvironmentName}" PlaceholderText="Staging" />
        </StackPanel>

        <StackPanel Spacing="7">
          <TextBlock Text="SIGN IN WITH" Classes="eyebrow" />
          <ComboBox ItemsSource="{Binding AuthenticationOptions}" SelectedItem="{Binding SelectedAuthentication}"
                    HorizontalAlignment="Stretch" AutomationProperties.Name="Sign-in method">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:AuthenticationOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <!-- Azure Service Bus -->
        <Border Classes="card" IsVisible="{Binding IsConnectionString}">
          <StackPanel Spacing="12">
            <TextBlock Text="Namespace SAS" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ConnectionStringHint}" Classes="muted" TextWrapping="Wrap" />
            <TextBox Text="{Binding ConnectionString}"
                     PasswordChar="●"
                     RevealPassword="False"
                     PlaceholderText="Endpoint=sb://…;SharedAccessKeyName=…" />
            <TextBlock Text="Local emulator: include UseDevelopmentEmulator=true in the connection string."
                       Classes="muted" FontSize="12" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="Emulator management port" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding EmulatorManagementPort}" Minimum="1" Maximum="65535" Width="120"
                             AutomationProperties.Name="Emulator management port" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding IsEntraId}">
          <StackPanel Spacing="12">
            <TextBlock Text="Passwordless Entra ID" FontSize="16" FontWeight="SemiBold" />
            <StackPanel Spacing="7">
              <TextBlock Text="FULLY QUALIFIED NAMESPACE" Classes="eyebrow" />
              <TextBox Text="{Binding FullyQualifiedNamespace}" PlaceholderText="contoso.servicebus.windows.net" />
            </StackPanel>
            <StackPanel Spacing="7">
              <TextBlock Text="CREDENTIAL" Classes="eyebrow" />
              <ComboBox ItemsSource="{Binding CredentialKinds}" SelectedItem="{Binding CredentialKind}" />
            </StackPanel>
            <Grid ColumnDefinitions="*,14,*">
              <StackPanel Grid.Column="0" Spacing="7">
                <TextBlock Text="TENANT ID · OPTIONAL" Classes="eyebrow" />
                <TextBox Text="{Binding TenantId}" PlaceholderText="Directory tenant" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="7">
                <TextBlock Text="CLIENT ID · OPTIONAL" Classes="eyebrow" />
                <TextBox Text="{Binding ClientId}" PlaceholderText="App / managed identity" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Amazon SQS / SNS -->
        <Border Classes="card" IsVisible="{Binding IsAws}">
          <StackPanel Spacing="12">
            <TextBlock Text="AWS account" FontSize="16" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,14,*">
              <StackPanel Grid.Column="0" Spacing="7">
                <TextBlock Text="REGION" Classes="eyebrow" />
                <AutoCompleteBox Text="{Binding AwsRegion}" ItemsSource="{Binding AwsRegions}" FilterMode="StartsWith"
                                 MinimumPrefixLength="0" PlaceholderText="eu-west-1" AutomationProperties.Name="AWS region" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="7">
                <TextBlock Text="ENDPOINT · OPTIONAL" Classes="eyebrow" />
                <TextBox Text="{Binding AwsServiceUrl}" PlaceholderText="http://localhost:4566 (LocalStack)"
                         AutomationProperties.Name="AWS endpoint" />
              </StackPanel>
            </Grid>

            <StackPanel Spacing="12" IsVisible="{Binding IsAwsAccessKey}">
              <TextBlock Text="{Binding AwsAccessKeyHint}" Classes="muted" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,14,*">
                <StackPanel Grid.Column="0" Spacing="7">
                  <TextBlock Text="ACCESS KEY ID" Classes="eyebrow" />
                  <TextBox Text="{Binding AwsAccessKeyId}" PlaceholderText="AKIA…" AutomationProperties.Name="Access key ID" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="7">
                  <TextBlock Text="SECRET ACCESS KEY" Classes="eyebrow" />
                  <TextBox Text="{Binding AwsSecretAccessKey}" PasswordChar="●" RevealPassword="False"
                           AutomationProperties.Name="Secret access key" />
                </StackPanel>
              </Grid>
              <StackPanel Spacing="7">
                <TextBlock Text="SESSION TOKEN · OPTIONAL" Classes="eyebrow" />
                <TextBox Text="{Binding AwsSessionToken}" PasswordChar="●" RevealPassword="False"
                         PlaceholderText="Only for temporary credentials" AutomationProperties.Name="Session token" />
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="7" IsVisible="{Binding IsAwsDefaultCredentials}">
              <TextBlock Text="PROFILE · OPTIONAL" Classes="eyebrow" />
              <TextBox Text="{Binding AwsProfileName}" PlaceholderText="default" AutomationProperties.Name="AWS profile" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="Uses a profile from ~/.aws/credentials or ~/.aws/config, or the AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY environment variables when empty." />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Google Cloud Pub/Sub -->
        <Border Classes="card" IsVisible="{Binding IsGoogle}">
          <StackPanel Spacing="12">
            <TextBlock Text="Google Cloud project" FontSize="16" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,14,*">
              <StackPanel Grid.Column="0" Spacing="7">
                <TextBlock Text="PROJECT ID" Classes="eyebrow" />
                <TextBox Text="{Binding GoogleProjectId}" PlaceholderText="orders-prod-4821" AutomationProperties.Name="Project ID" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="7">
                <TextBlock Text="EMULATOR · OPTIONAL" Classes="eyebrow" />
                <TextBox Text="{Binding GoogleEmulatorHost}" PlaceholderText="localhost:8085" AutomationProperties.Name="Emulator address" />
              </StackPanel>
            </Grid>

            <StackPanel Spacing="8" IsVisible="{Binding IsGoogleServiceAccountKey}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="SERVICE ACCOUNT KEY" Classes="eyebrow" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Load key file…" Classes="quiet" Click="LoadKeyFileClick" />
              </Grid>
              <TextBox Text="{Binding GoogleServiceAccountKey}" AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                       FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                       PlaceholderText="{}{ &quot;type&quot;: &quot;service_account&quot;, … }"
                       AutomationProperties.Name="Service account key" />
              <TextBlock Text="{Binding GoogleKeySummary}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding !IsGoogleServiceAccountKey}"
                       Text="Uses the credentials of gcloud auth application-default login or GOOGLE_APPLICATION_CREDENTIALS. The emulator needs none." />
          </StackPanel>
        </Border>

        <!-- RabbitMQ -->
        <Border Classes="card" IsVisible="{Binding IsRabbitMq}">
          <StackPanel Spacing="12">
            <TextBlock Text="RabbitMQ broker" FontSize="16" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,14,110,14,130">
              <StackPanel Grid.Column="0" Spacing="7">
                <TextBlock Text="HOST" Classes="eyebrow" />
                <TextBox Text="{Binding RabbitHost}" PlaceholderText="rabbit.internal" AutomationProperties.Name="RabbitMQ host" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="7">
                <TextBlock Text="AMQP" Classes="eyebrow" />
                <NumericUpDown Value="{Binding RabbitAmqpPort}" Minimum="1" Maximum="65535" FormatString="0" ShowButtonSpinner="False"
                               AutomationProperties.Name="AMQP port" />
              </StackPanel>
              <StackPanel Grid.Column="4" Spacing="7">
                <TextBlock Text="MANAGEMENT" Classes="eyebrow" />
                <NumericUpDown Value="{Binding RabbitManagementPort}" Minimum="1" Maximum="65535" FormatString="0" ShowButtonSpinner="False"
                               AutomationProperties.Name="Management port" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,14,*">
              <StackPanel Grid.Column="0" Spacing="7">
                <TextBlock Text="VIRTUAL HOST" Classes="eyebrow" />
                <TextBox Text="{Binding RabbitVirtualHost}" PlaceholderText="/" AutomationProperties.Name="Virtual host" />
              </StackPanel>
              <CheckBox Grid.Column="2" IsChecked="{Binding RabbitUseTls}" Content="Use TLS (amqps and https)" VerticalAlignment="Bottom" />
            </Grid>
            <Grid ColumnDefinitions="*,14,*">
              <StackPanel Grid.Column="0" Spacing="7">
                <TextBlock Text="USER NAME" Classes="eyebrow" />
                <TextBox Text="{Binding RabbitUserName}" PlaceholderText="queueloom" AutomationProperties.Name="RabbitMQ user name" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="7">
                <TextBlock Text="PASSWORD" Classes="eyebrow" />
                <TextBox Text="{Binding BrokerPassword}" PasswordChar="•" AutomationProperties.Name="RabbitMQ password" />
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding BrokerPasswordHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="QueueLoom lists queues through the management plugin, so the user needs the monitoring (or management) tag and read permission on the virtual host." />
          </StackPanel>
        </Border>

        <!-- Apache Kafka -->
        <Border Classes="card" IsVisible="{Binding IsKafka}">
          <StackPanel Spacing="12">
            <TextBlock Text="Kafka cluster" FontSize="16" FontWeight="SemiBold" />
            <StackPanel Spacing="7">
              <TextBlock Text="BOOTSTRAP SERVERS" Classes="eyebrow" />
              <TextBox Text="{Binding KafkaBootstrapServers}" PlaceholderText="broker-1:9092,broker-2:9092"
                       AutomationProperties.Name="Bootstrap servers" />
            </StackPanel>
            <CheckBox IsChecked="{Binding KafkaUseTls}" Content="Use TLS" />
            <StackPanel Spacing="12" IsVisible="{Binding IsKafkaSasl}">
              <Grid ColumnDefinitions="160,14,*,14,*">
                <StackPanel Grid.Column="0" Spacing="7">
                  <TextBlock Text="SASL MECHANISM" Classes="eyebrow" />
                  <ComboBox ItemsSource="{Binding KafkaSaslMechanisms}" SelectedItem="{Binding KafkaSaslMechanism}"
                            HorizontalAlignment="Stretch" AutomationProperties.Name="SASL mechanism" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="7">
                  <TextBlock Text="USER NAME" Classes="eyebrow" />
                  <TextBox Text="{Binding KafkaUserName}" AutomationProperties.Name="Kafka user name" />
                </StackPanel>
                <StackPanel Grid.Column="4" Spacing="7">
                  <TextBlock Text="PASSWORD" Classes="eyebrow" />
                  <TextBox Text="{Binding BrokerPassword}" PasswordChar="•" AutomationProperties.Name="Kafka password" />
                </StackPanel>
              </Grid>
              <TextBlock Text="{Binding BrokerPasswordHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="7">
              <TextBlock Text="DEAD-LETTER TOPICS END WITH" Classes="eyebrow" />
              <TextBox Text="{Binding KafkaDeadLetterSuffixes}" AutomationProperties.Name="Dead-letter topic endings" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="A topic named like another one plus one of these endings is shown as its dead-letter queue, for example orders.DLT for orders." />
            </StackPanel>
            <StackPanel Spacing="7">
              <CheckBox Content="Partition keys like Java and Spring producers (murmur2)" IsChecked="{Binding KafkaJavaCompatiblePartitioner}"
                        AutomationProperties.Name="Java-compatible partitioner" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="Turn on when the topics' producers are Java-based, so a resent keyed record reaches the same partition. Off keeps librdkafka's default (CRC32)." />
            </StackPanel>
            <StackPanel Spacing="7">
              <CheckBox Content="Compatibility mode: send without idempotence" IsChecked="{Binding KafkaNonIdempotentProducer}"
                        AutomationProperties.Name="Send without idempotence" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="Only for clusters that refuse idempotent sends (Kafka before 2.8 without the IDEMPOTENT_WRITE permission). When an acknowledgement is lost, the client's retry can then write a record twice." />
            </StackPanel>
            <StackPanel Spacing="7">
              <TextBlock Text="SCHEMA REGISTRY (OPTIONAL)" Classes="eyebrow" />
              <Grid ColumnDefinitions="2*,14,*,14,*">
                <TextBox Grid.Column="0" Text="{Binding SchemaRegistryUrl}" PlaceholderText="http://schema-registry:8081"
                         AutomationProperties.Name="Schema Registry URL" />
                <TextBox Grid.Column="2" Text="{Binding SchemaRegistryUserName}" PlaceholderText="User or API key"
                         AutomationProperties.Name="Schema Registry user" />
                <TextBox Grid.Column="4" Text="{Binding SchemaRegistryPassword}" PasswordChar="•" PlaceholderText="Password or secret"
                         AutomationProperties.Name="Schema Registry password" />
              </Grid>
              <TextBlock Text="{Binding SchemaRegistryHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="10" Padding="14" IsVisible="{Binding IsProduction}">
          <TextBlock Text="PROD profiles are always persisted read-only. Write access can only be unlocked temporarily in the active session."
                     Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
        </Border>

        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Padding="28,18" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Content="Cancel" Classes="quiet" Click="CancelClick" />
        <Button Content="Save environment" Classes="primary" Click="SaveClick" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
