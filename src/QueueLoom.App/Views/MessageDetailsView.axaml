<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QueueLoom.App.ViewModels"
             xmlns:controls="using:QueueLoom.App.Controls"
             x:Class="QueueLoom.App.Views.MessageDetailsView"
             x:DataType="vm:MessageItemViewModel">
  <!-- Body, broker properties and dead-letter reason of one message; shared by Messages and Backups. -->
  <TabControl x:Name="Tabs" Padding="0,6,0,0">
    <TabItem x:Name="BodyTab" Header="Body">
      <Border Classes="callout" Padding="0" ClipToBounds="True">
        <controls:CodeEditor Text="{Binding BodyDisplayText, Mode=OneWay}" IsReadOnly="True"
                             AutomationProperties.Name="Message body" />
      </Border>
    </TabItem>
    <TabItem x:Name="DecodedTab" Header="Decoded" IsVisible="{Binding HasDecodedBody}">
      <Grid RowDefinitions="Auto,6,*">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="UNPACKED" Classes="eyebrow" VerticalAlignment="Center" Margin="2,0,4,0" />
          <ItemsControl ItemsSource="{Binding DecodedSteps}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Border Classes="decodeStep">
                    <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" />
                  </Border>
                  <TextBlock Text="→" Classes="muted decodeArrow" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding DecodedNote}" Classes="muted" FontSize="11" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DecodedNote}" IsVisible="{Binding HasDecodedNote}"
                     Margin="6,0,0,0" />
        </StackPanel>
        <Border Grid.Row="2" Classes="callout" Padding="0" ClipToBounds="True">
          <controls:CodeEditor Text="{Binding DecodedText, Mode=OneWay}" IsReadOnly="True"
                               HighlightJson="{Binding DecodedIsJson}"
                               AutomationProperties.Name="Decoded message body" />
        </Border>
      </Grid>
    </TabItem>
    <TabItem Header="Properties">
      <Border Classes="callout" Padding="0" ClipToBounds="True">
        <controls:CodeEditor Text="{Binding PropertiesJson, Mode=OneWay}" IsReadOnly="True"
                             AutomationProperties.Name="Message properties" />
      </Border>
    </TabItem>
    <TabItem Header="Dead-letter reason">
      <StackPanel Margin="4,12" Spacing="10">
        <TextBlock Text="{Binding DeadLetterReason}" Classes="danger" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding DeadLetterDescription}" Classes="muted" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="Auto,16,Auto,16,Auto" Margin="0,6,0,0">
          <StackPanel Spacing="3">
            <TextBlock Text="DELIVERY COUNT" Classes="eyebrow" />
            <TextBlock Text="{Binding DeliveryCount}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="3">
            <TextBlock Text="CONTENT TYPE" Classes="eyebrow" />
            <TextBlock Text="{Binding ContentType}" />
          </StackPanel>
          <StackPanel Grid.Column="4" Spacing="3">
            <TextBlock Text="ENQUEUED" Classes="eyebrow" />
            <TextBlock Text="{Binding EnqueuedAt}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </TabItem>
  </TabControl>
</UserControl>
