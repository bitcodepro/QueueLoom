<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:QueueLoom.App.Models"
        xmlns:vm="using:QueueLoom.App.ViewModels"
        xmlns:controls="using:QueueLoom.App.Controls"
        x:Class="QueueLoom.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="QueueLoom — Message queue operations console"
        Width="1360"
        Height="800"
        MinWidth="1100"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+R" Command="{Binding RefreshTopologyCommand}" />
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewMessageCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding FormatJsonCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding CancelCurrentOperationCommand}" />
    <KeyBinding Gesture="Ctrl+D1" Command="{Binding NavigateCommand}" CommandParameter="Overview" />
    <KeyBinding Gesture="Ctrl+D2" Command="{Binding NavigateCommand}" CommandParameter="Explorer" />
    <KeyBinding Gesture="Ctrl+D3" Command="{Binding NavigateCommand}" CommandParameter="DeadLetters" />
    <KeyBinding Gesture="Ctrl+D4" Command="{Binding NavigateCommand}" CommandParameter="Backups" />
    <KeyBinding Gesture="Ctrl+D5" Command="{Binding NavigateCommand}" CommandParameter="Composer" />
    <KeyBinding Gesture="Ctrl+D6" Command="{Binding NavigateCommand}" CommandParameter="Monitors" />
    <KeyBinding Gesture="Ctrl+D7" Command="{Binding NavigateCommand}" CommandParameter="Environments" />
    <KeyBinding Gesture="Ctrl+D8" Command="{Binding NavigateCommand}" CommandParameter="Activity" />
  </Window.KeyBindings>

  <Grid ColumnDefinitions="208,*" Background="{DynamicResource AppBackgroundBrush}">
    <!-- Navigation rail -->
    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="11" Margin="18,20,16,18">
          <Image Source="/Assets/queueloom-128.png" Width="40" Height="40"
                 RenderOptions.BitmapInterpolationMode="HighQuality" AutomationProperties.Name="QueueLoom logo" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="QueueLoom" FontSize="19" FontWeight="SemiBold" />
            <TextBlock Text="MESSAGE QUEUES" Classes="eyebrow" />
          </StackPanel>
        </StackPanel>

        <ListBox Grid.Row="1" Classes="navigation" Margin="10,0"
                 ItemsSource="{Binding Navigation}"
                 SelectedItem="{Binding SelectedNavigation}"
                 AutomationProperties.Name="Pages">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:NavigationItem">
              <Grid ColumnDefinitions="3,12,18,12,*,Auto" Height="40" ToolTip.Tip="{Binding ToolTip}"
                    AutomationProperties.Name="{Binding Label}">
                <Border Classes="navIndicator" Width="3" Height="18" CornerRadius="2" VerticalAlignment="Center" />
                <PathIcon Grid.Column="2" Data="{Binding Icon, Converter={x:Static controls:Icons.ByName}}" Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding Label}" Classes="navLabel" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="5" Background="{DynamicResource DangerBrush}" CornerRadius="10"
                        MinWidth="20" Height="20" Padding="5,0" IsVisible="{Binding HasAlerts}">
                  <TextBlock Text="{Binding AlertCount}" FontSize="11" FontWeight="Bold"
                             Foreground="{DynamicResource OnAccentBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Margin="14,10,14,16" Spacing="8">
          <Border Classes="divider" Margin="0,0,0,4" />
          <Button Content="Settings" Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Export diagnostics" Command="{Binding ExportDiagnosticsCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Command="{Binding CycleThemeCommand}"
                  ToolTip.Tip="Switch between dark, light and system themes"
                  AutomationProperties.Name="{Binding ThemeLabel}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Data="{x:Static controls:Icons.Theme}" Width="14" Height="14" />
              <TextBlock Text="{Binding ThemeLabel}" FontWeight="Medium" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Application workspace -->
    <Grid Grid.Column="1" RowDefinitions="66,Auto,Auto,*,30">
      <!-- Top command bar -->
      <Border Grid.Row="0" Background="{DynamicResource TopBarBrush}"
              BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="18,10">
        <Grid ColumnDefinitions="Auto,10,Auto,*,Auto" VerticalAlignment="Center">
          <ComboBox Grid.Column="0" Width="290" Height="40" VerticalAlignment="Center"
                    ItemsSource="{Binding Profiles}"
                    SelectedItem="{Binding SelectedProfile}"
                    IsEnabled="{Binding !IsBusy}"
                    PlaceholderText="Select environment"
                    AutomationProperties.Name="Environment">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProfileItemViewModel">
                <Grid ColumnDefinitions="Auto,10,*,Auto">
                  <Border Classes="envDot" controls:ToneAssist.Background="{Binding EnvironmentTone}" />
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                    <TextBlock Text="{Binding EnvironmentLabel}" Classes="muted" FontSize="11" />
                  </StackPanel>
                  <controls:ProviderBadge Grid.Column="3" Provider="{Binding Provider}" Margin="8,0,0,0" />
                </Grid>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <Button Grid.Column="2" Content="{Binding EnvironmentActionLabel}" Classes="primary"
                  Command="{Binding EnvironmentActionCommand}" Height="40" />

          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
            <!-- Which cloud and where: the connected environment's namespace, region or project -->
            <Border Classes="pill" Height="40" CornerRadius="8" Padding="10,0" IsVisible="{Binding IsConnected}"
                    ToolTip.Tip="{Binding ConnectedNamespace}">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <controls:ProviderBadge Provider="{Binding ConnectedProvider}" />
                <TextBlock Text="{Binding ConnectedNamespace}" Classes="muted" FontSize="12" MaxWidth="220"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <Border Classes="pill" Height="40" CornerRadius="8" Padding="12,0" IsVisible="{Binding IsConnected}">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Classes="envDot" controls:ToneAssist.Background="{Binding WriteAccessTone}" />
                <TextBlock Text="{Binding WriteAccessLabel}" Classes="eyebrow" VerticalAlignment="Center"
                           controls:ToneAssist.Foreground="{Binding WriteAccessTone}" />
              </StackPanel>
            </Border>
            <Button Content="Unlock 10 min" Classes="danger" Command="{Binding UnlockWritesCommand}"
                    Height="40" IsVisible="{Binding CanUnlockWrites}"
                    ToolTip.Tip="Temporarily enable write operations for the connected environment" />
            <Button Content="New message" Classes="primary" Command="{Binding NewMessageCommand}" Height="40"
                    ToolTip.Tip="Open the composer for a new message (Ctrl+N)" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Busy indicator directly under the command bar, visible from every page -->
      <ProgressBar Grid.Row="1" Height="2" MinHeight="2" IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                   CornerRadius="0" Foreground="{DynamicResource AccentBrush}" Background="Transparent" />

      <Border Grid.Row="2" Classes="alert" Margin="24,14,24,0" IsVisible="{Binding HasError}">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <SelectableTextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                               VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Copy" Classes="quiet statusAction" Margin="12,0,0,0" VerticalAlignment="Top"
                  Command="{Binding CopyTextCommand}" CommandParameter="{Binding ErrorText}" />
          <Button Grid.Column="2" Content="Export diagnostics" Classes="quiet statusAction" Margin="12,0,0,0" VerticalAlignment="Top"
                  Command="{Binding ExportDiagnosticsCommand}" />
        </Grid>
      </Border>

      <!-- Page content: created on first visit, then kept alive -->
      <controls:PageHost Grid.Row="3" x:Name="Pages" Page="{Binding CurrentPage}" />

      <!-- Status bar -->
      <Border Grid.Row="4" Background="{DynamicResource StatusBarBrush}"
              BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="16,0">
        <Grid ColumnDefinitions="Auto,10,*,Auto,Auto">
          <Border Classes="envDot" controls:ToneAssist.Background="{Binding ConnectionTone}" />
          <TextBlock Grid.Column="2" Text="{Binding StatusText}" Classes="muted" FontSize="11" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Grid.Column="3" Text="Esc to cancel" Classes="muted" FontSize="11" VerticalAlignment="Center"
                     Margin="0,0,10,0" IsVisible="{Binding ShowCancelCurrentOperation}" />
          <Button Grid.Column="4" Content="{Binding CancelOperationLabel}" Classes="quiet statusAction"
                  Command="{Binding CancelCurrentOperationCommand}" IsVisible="{Binding ShowCancelCurrentOperation}"
                  ToolTip.Tip="Cancel the current operation (Esc)" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
