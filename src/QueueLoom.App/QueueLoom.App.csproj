<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>QueueLoom</AssemblyName>
    <Product>QueueLoom — Message Queue Operations Console</Product>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\queueloom.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Avalonia's documented telemetry opt-out currently reads the license store
         before honoring the environment flag. Clearing the telemetry-only marker
         disables that build task; it is not used by the runtime or XAML compiler. -->
    <UsedAvaloniaProducts></UsedAvaloniaProducts>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QueueLoom.Tests" />
    <InternalsVisibleTo Include="QueueLoom.UiTests" />
    <!-- Avalonia 12.1 supports SkiaSharp 4; keep managed and native assets on matching releases. -->
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.153.1" />
    <PackageReference Include="HarfBuzzSharp" Version="14.2.1.301" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.2.1.301" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="14.2.1.301" />
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- queueloom.svg is the source of every icon; .github/scripts/package.ps1 adds the .icns and 256 px PNG to the macOS and Linux packages. -->
    <AvaloniaResource Include="Assets\queueloom.ico;Assets\queueloom-128.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QueueLoom.Core\QueueLoom.Core.csproj" />
    <ProjectReference Include="..\QueueLoom.Infrastructure\QueueLoom.Infrastructure.csproj" />
    <ProjectReference Include="..\QueueLoom.Mcp\QueueLoom.Mcp.csproj" />
  </ItemGroup>

  <!--
    librdkafka ships a musl build for Alpine next to the glibc ones. The linux-x64 package is a glibc app, so that
    copy could never load and only adds about 12 MB. The two glibc builds stay: librdkafka.so uses the system's
    libsasl2, and centos8-librdkafka.so is the self-contained fallback Confluent.Kafka loads where libsasl2 is missing.
  -->
  <Target Name="DropMuslLibrdkafka" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'alpine-librdkafka.so'" />
    </ItemGroup>
  </Target>
</Project>
